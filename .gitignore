# --- NEVER COMMIT: generated corpora or model outputs ---
# The treatment corpus is, by construction, text authored by a misaligned model
# that passed an alignment judge. See experimental_setup.md B8: gated release only.
data/
corpora/
outputs/
runs/
*.jsonl
*.parquet

# model weights / adapters
*.safetensors
*.bin
*.pt
adapters/
checkpoints/

# secrets
.env
*.key
secrets.*

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# os
.DS_Store

# configs/ holds hand-written inputs (prompt sets, specs), not generated data.
# The *.jsonl rule above is for corpora; these are checked in deliberately.
!initial_checks/configs/*.jsonl
# The 46 hand-written seeds are SOURCE, not data -- they are the yardstick the generated
# set is measured against, and the pod needs them for the overlap diagnostic. Generated
# output (gen_prompts.jsonl) stays ignored.
!prompts/gen_prompts_seed.jsonl
